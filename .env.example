# Copy to .env (pipeline) or apps/api/.dev.vars (Worker). Never commit real values.

# --- Worker (apps/api) ---
# Shared secret the pipeline uses to sign POST /api/ingest requests (HMAC-SHA256).
INGEST_HMAC_SECRET=change-me-long-random-string
# Bearer token the publish workflow uses to read GET /api/snapshot.
PUBLISH_TOKEN=change-me-another-long-random-string
# Comma-separated origins allowed to call the public API from the browser.
ALLOWED_ORIGINS=http://localhost:4321,https://myavedan.in
IP_HASH_SALT=change-me-random-salt

# Review console sign-in (Better Auth, as on TrutiAI). See docs/REVIEW_CONSOLE.md.
BETTER_AUTH_SECRET=change-me-64-random-hex-characters
# Emails that become admin when they sign in, comma-separated.
ADMIN_EMAILS=admin@example.com
# Local development only: email + password sign-in. Never set on staging or production.
AUTH_DEV_LOGIN=true
# Staging/production only (wrangler secret put): Google OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Pipeline (pipeline/) ---
# Google AI Studio key from a Google project WITHOUT billing enabled (free tier only).
GEMINI_API_KEY=
GEMINI_MODEL=
INGEST_URL=http://localhost:8787/api/ingest
# R2 S3-compatible credentials, scoped to the documents bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=myavedan-documents-staging

# --- Site (apps/web) ---
# Base URL of the Worker API, used by islands such as "Report an error".
PUBLIC_API_BASE=http://localhost:8787
