---
import type { Opportunity } from "@myavedan/schema";
import { QUALIFICATION_LABEL, dateValue, formatDate, formatDateTime } from "@myavedan/schema";
import StatusPill from "./StatusPill.astro";
import SaveButton from "./SaveButton.astro";
import { jurisdictionLabel } from "../lib/snapshot";

interface Props {
  o: Opportunity;
  headingLevel?: 2 | 3;
}
const { o, headingLevel = 3 } = Astro.props;
const end = dateValue(o.dates, "apply_end");
const Heading = headingLevel === 2 ? "h2" : "h3";
const pay = o.posts.find((p) => p.pay)?.pay;
const quals = o.qualification_levels.map((q) => QUALIFICATION_LABEL[q]).join(", ");

// A soft coloured tile per kind of employer, as in the design.
const hay = `${o.title} ${o.organization.name}`.toLowerCase();
const tile = /police|army|navy|air force|defence|cisf|crpf|bsf|itbp|ssb|guard/.test(hay)
  ? { bg: "#eef2ff", border: "#e0e7ff", fg: "#4f46e5", d: "M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6z" }
  : /bank|sbi|rbi|ibps|lic|insurance|finance/.test(hay)
    ? { bg: "#ecfdf5", border: "#d1fae5", fg: "#059669", d: "M3 21h18M5 18V10M9 18V10M15 18V10M19 18V10M12 3l9 5H3z" }
    : /rail|rrb|rrc/.test(hay)
      ? { bg: "#fff7ed", border: "#ffedd5", fg: "#ea580c", d: "M6 16V6a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v10M6 12h12M8 20l-2 2M16 20l2 2M5 16h14v2a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z" }
      : /teach|school|education|university|vidyalaya/.test(hay)
        ? { bg: "#fffbeb", border: "#fef3c7", fg: "#d97706", d: "M22 10 12 5 2 10l10 5zM6 12v5c3 2 9 2 12 0v-5" }
        : /medical|health|hospital|nurs|aiims/.test(hay)
          ? { bg: "#fff1f2", border: "#ffe4e6", fg: "#e11d48", d: "M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z" }
          : { bg: "#eff6ff", border: "#dbeafe", fg: "#2563eb", d: "M4 21V7l8-4 8 4v14M9 21v-6h6v6M4 21h16" };
---

<article class="card card-listing group relative flex h-full flex-col justify-between rounded-2xl">
  <div class="space-y-4">
    <div class="flex items-start justify-between gap-3">
      <div class="flex min-w-0 gap-3 sm:gap-4">
        <span class="icon-tile" style={`background:${tile.bg};border-color:${tile.border};color:${tile.fg}`} aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={tile.d}></path></svg>
        </span>
        <div class="min-w-0">
          <Heading class="font-display text-lg font-bold leading-snug">
            <a href={`/opportunity/${o.slug}/`} class="stretched card-title text-ink no-underline transition-colors">{o.title}</a>
          </Heading>
          <p class="text-sm font-medium text-ink-2">{o.organization.name}</p>
        </div>
      </div>
      <span class="hidden shrink-0 rounded bg-sunk px-2 py-1 text-[11px] font-bold uppercase tracking-widest text-ink-3 sm:inline">
        {formatDate(o.provenance.last_checked_at)}
      </span>
    </div>
    <p class="line-clamp-2 text-sm leading-relaxed text-ink-3">{o.summary.en}</p>
    <div class="flex flex-wrap gap-2">
      <span class="elig" data-elig={o.slug} hidden></span>
      <StatusPill o={o} />
      {o.total_vacancies !== null && <span class="tag">{o.total_vacancies.toLocaleString("en-IN")} posts</span>}
      {pay && <span class="tag tag-teal">{pay.length > 34 ? `${pay.slice(0, 32)}…` : pay}</span>}
      <span class="tag tag-blue">{quals}</span>
      <span class="tag">{jurisdictionLabel(o)}</span>
    </div>
  </div>
  <div class="mt-6 flex items-center justify-between gap-3 border-t border-line pt-5">
    <div class="text-sm">
      <p class="text-xs text-ink-3">Last date</p>
      <p class="num font-semibold text-ink">{end ? formatDateTime(end) : "Not announced"}</p>
    </div>
    <span class="flex items-center gap-2">
      <SaveButton slug={o.slug} />
      <span class="btn btn-primary pointer-events-none whitespace-nowrap px-4 py-2.5 text-sm sm:px-5" aria-hidden="true">View details</span>
    </span>
  </div>
</article>
