---
const links = [
  { href: "/explore/", label: "Openings" },
  { href: "/results/", label: "Results" },
  { href: "/admit-cards/", label: "Admit cards" },
  { href: "/can-i-apply/", label: "Can I apply?" },
  { href: "/saved/", label: "Saved" },
  { href: "/profile/", label: "My profile" },
];
const path = Astro.url.pathname;
const current = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-[90rem] items-center gap-6 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5 text-ink no-underline" aria-label="MyAvedan home">
      <span class="grid h-10 w-10 place-items-center rounded-lg bg-brand text-on-brand">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 22h18M6 18v-7M10 18v-7M14 18v-7M18 18v-7M12 2l9 5H3z"></path>
        </svg>
      </span>
      <span class="flex flex-col">
        <span class="font-display text-lg font-bold leading-tight tracking-tight">MyAvedan</span>
        <span class="text-[10px] font-semibold uppercase tracking-widest text-ink-3">Verified notices</span>
      </span>
    </a>
    <nav aria-label="Main" class="hidden items-center gap-6 text-sm font-medium lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={current(l.href) ? "page" : undefined}
            class:list={["no-underline transition-colors", current(l.href) ? "text-brand" : "text-ink-2 hover:text-brand"]}
          >
            {l.label}
            {l.href === "/profile/" && <span data-updates-count hidden class="ml-1 rounded-full bg-accent px-1.5 text-xs font-bold text-ink" />}
          </a>
        ))
      }
    </nav>
    <form action="/explore/" method="get" role="search" class="ml-auto hidden max-w-xl flex-1 md:block">
      <label for="hdr-q" class="sr-only">Search openings</label>
      <div class="relative flex items-center">
        <svg class="pointer-events-none absolute left-4 text-ink-3" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          id="hdr-q"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Search posts, departments or keywords…"
          class="w-full rounded-full border-0 bg-sunk py-2.5 pl-12 pr-4 text-sm outline-none focus:ring-2 focus:ring-brand/20"
        />
      </div>
    </form>
  </div>
  <nav aria-label="Main" class="flex gap-1 overflow-x-auto border-t border-line px-3 py-2 lg:hidden">
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={current(l.href) ? "page" : undefined}
          class:list={[
            "whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-medium no-underline",
            current(l.href) ? "bg-brand-soft text-brand-ink" : "text-ink-2",
          ]}
        >
          {l.label}
        </a>
      ))
    }
  </nav>
</header>
