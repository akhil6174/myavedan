---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { isSample } from "../lib/snapshot";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Find official government recruitment notices, understand the rules, check your eligibility and keep track of every date.",
} = Astro.props;
const fullTitle = title === "MyAvedan" ? "MyAvedan · Find, understand and track government jobs" : `${title} · MyAvedan`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://myavedan.in").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isSample && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MyAvedan" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    {
      isSample && (
        <div class="border-b border-warn bg-warn-soft" role="note">
          <p class="wrap py-2 text-sm text-ink">
            <strong>Sample data.</strong> These notices are invented to show how MyAvedan works. Organisations, numbers and links are
            not real.
          </p>
        </div>
      )
    }
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Recompute every status label from stored dates, in IST, at page load.
      import { computeStatus, describeStatus, statusTone } from "@myavedan/schema/status";
      for (const el of document.querySelectorAll<HTMLElement>("[data-live-status]")) {
        try {
          const info = computeStatus(JSON.parse(el.dataset.liveStatus ?? ""));
          el.textContent = describeStatus(info);
          el.dataset.tone = statusTone(info);
          el.dataset.status = info.status;
        } catch {
          // Keep the build-time label.
        }
      }
      document.dispatchEvent(new CustomEvent("myavedan:status-ready"));
    </script>
    <script>
      // Saved recruitments live on this device only. If storage is blocked, saving simply doesn't stick.
      const KEY = "myavedan:saved";
      const read = (): string[] => {
        try {
          return JSON.parse(localStorage.getItem(KEY) ?? "[]");
        } catch {
          return [];
        }
      };
      const write = (list: string[]) => {
        try {
          localStorage.setItem(KEY, JSON.stringify(list));
        } catch {
          /* not kept */
        }
      };
      const paint = () => {
        const saved = new Set(read());
        for (const b of document.querySelectorAll<HTMLButtonElement>("[data-save]")) {
          const on = saved.has(b.dataset.save!);
          b.setAttribute("aria-pressed", String(on));
          b.classList.toggle("is-saved", on);
          const label = b.querySelector("[data-save-label]");
          if (label) label.textContent = on ? "Saved" : "Save";
        }
        document.dispatchEvent(new CustomEvent("myavedan:saved-changed", { detail: [...saved] }));
      };
      document.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-save]");
        if (!b) return;
        e.preventDefault();
        e.stopPropagation();
        const list = read();
        const slug = b.dataset.save!;
        write(list.includes(slug) ? list.filter((s) => s !== slug) : [slug, ...list]);
        paint();
      });
      paint();
    </script>
  </body>
</html>
