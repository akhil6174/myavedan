---
import Base from "../layouts/Base.astro";
import ReportForm from "../components/ReportForm.tsx";
import { opportunities } from "../lib/snapshot";

const notices = opportunities.map((o) => ({ slug: o.slug, title: o.title }));
---

<Base title="About and trust" description="Who runs MyAvedan, how notices are verified, which sources are used, how AI is used, and how to report an error.">
  <section class="border-b border-line bg-surface">
    <div class="wrap py-8">
      <p class="eyebrow">A TrutiAI product</p>
      <h1 class="mt-2 text-3xl sm:text-4xl">About MyAvedan</h1>
      <p class="mt-3 max-w-2xl text-lg text-ink-2">
        <span lang="hi">आवेदन</span> (avedan) means “application”. MyAvedan helps you find official recruitment notices, understand them,
        check whether you can apply, and keep track of what happens next.
      </p>
    </div>
  </section>

  <div class="wrap prose-page py-6">
    <p>
      MyAvedan is an independent information and assistance platform developed by TrutiAI. It is not a government website and is not
      affiliated with any recruiting authority unless explicitly stated. You always apply, pay and download admit cards on the official
      portal. MyAvedan never asks for portal passwords, OTPs, Aadhaar numbers or bank details.
    </p>

    <h2 id="how-we-verify">How we verify notices</h2>
    <ol>
      <li>We find new and changed notices on official recruitment websites only.</li>
      <li>We keep a copy of the exact file and record when we retrieved it.</li>
      <li>Software reads the whole notice and drafts the key facts, each with the page and passage it came from.</li>
      <li>Automatic checks look for impossible dates, numbers that don't add up and links outside the official site.</li>
      <li>A person compares every date, age limit, qualification, fee and vacancy count with the notice before it is published.</li>
      <li>When the notice changes, we publish a new version and keep the old one, so nothing is silently overwritten.</li>
    </ol>
    <p>
      “Checked against the official notice” on a listing means all of these steps happened. Each listing links to the official notice PDF
      so you can read it yourself.
    </p>

    <h2 id="sources">Source policy</h2>
    <ul>
      <li>Sources are official recruitment websites of central and state bodies. We do not copy listings from other job portals.</li>
      <li>Every listing shows the official website it came from and links to the original notice.</li>
      <li>We respect each website's terms, robots instructions and reasonable request rates, and never bypass logins or CAPTCHAs.</li>
      <li>We do not claim to cover every recruitment in India. Coverage grows source by source.</li>
    </ul>

    <h2 id="ai">How we use AI</h2>
    <ul>
      <li>AI helps draft the structured facts and plain-language summaries from each notice. A person reviews them before publishing.</li>
      <li>The eligibility checker does not use AI. It applies the published rules with fixed, tested logic, and shows the rule behind every answer.</li>
      <li>We never send your date of birth, category or contact details to an AI service.</li>
      <li>AI-generated explanations may contain errors. The official notification is always the authority.</li>
    </ul>

    <h2 id="corrections">Report an error</h2>
    <p>
      If something on a listing does not match the official notice, tell us. Reports about dates, eligibility and fees go to the top of
      the review queue. When we correct a listing, the page shows what changed and when.
    </p>
  </div>
  <div class="wrap pb-6">
    <div class="max-w-2xl">
      <ReportForm client:idle notices={notices} />
    </div>
  </div>

  <div class="wrap prose-page pb-6">
    <h2 id="contact">Contact</h2>
    <p>MyAvedan is built and operated by TrutiAI. For questions, corrections or anything else, email <a href="mailto:akhill6174dwivedi@gmail.com">akhill6174dwivedi@gmail.com</a>.</p>
  </div>
</Base>
