---
import Base from "../layouts/Base.astro";
import OpportunityCard from "../components/OpportunityCard.astro";
import { QUALIFICATION_LABEL, QualificationLevel, dateValue } from "@myavedan/schema";
import { opportunities, statesInUse } from "../lib/snapshot";

const states = statesInUse();
const levels = QualificationLevel.options;

const items = opportunities.map((o) => ({
  o,
  text: [o.title, o.organization.name, o.organization.short, o.advt_no, ...o.locations, ...o.posts.map((p) => p.name)]
    .filter(Boolean)
    .join(" ")
    .toLowerCase(),
  states: [o.organization.state, ...o.locations].filter(Boolean).join("|"),
  quals: o.qualification_levels.join("|"),
  end: (dateValue(o.dates, "apply_end") ?? "9999-12-31").slice(0, 10),
  notified: (dateValue(o.dates, "notification") ?? o.provenance.reviewed_at).slice(0, 10),
}));
---

<Base title="Explore opportunities" description="Search and filter official government recruitment notices by qualification, state, status and deadline.">
  <div class="mx-auto grid max-w-[90rem] lg:grid-cols-[18rem_minmax(0,1fr)]">
    <div class="fixed inset-0 z-40 bg-ink/40 lg:hidden" id="filter-backdrop" hidden></div>
    <aside id="filter-panel" class="fixed inset-y-0 left-0 z-50 hidden w-[85vw] max-w-xs overflow-y-auto border-line bg-surface p-6 shadow-xl lg:z-auto lg:block lg:w-auto lg:max-w-none lg:shadow-none lg:sticky lg:top-[65px] lg:h-[calc(100vh-65px)] lg:overflow-y-auto lg:border-r" aria-label="Filters">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="font-display font-bold text-ink">Filters</h2>
        <span class="flex items-center gap-4">
          <a href="/explore/" id="clear" class="text-xs font-semibold text-brand no-underline hover:underline">Reset all</a>
          <button type="button" id="filter-close" class="grid h-8 w-8 place-items-center rounded-full text-ink-3 hover:bg-sunk lg:hidden" aria-label="Close filters">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
          </button>
        </span>
      </div>
      <form id="filters" class="space-y-7" role="search">
        <div>
          <label for="f-q" class="mb-3 block text-xs font-bold uppercase tracking-wider text-[#94a3b8]">Keyword</label>
          <input id="f-q" name="q" type="search" class="w-full rounded-lg border border-line bg-paper p-2.5 text-sm outline-none focus:border-brand" placeholder="Post, organisation, place" autocomplete="off" />
        </div>
        <div>
          <label for="f-status" class="mb-3 block text-xs font-bold uppercase tracking-wider text-[#94a3b8]">Status</label>
          <select id="f-status" name="status" class="w-full rounded-lg border border-line bg-paper p-2.5 text-sm outline-none focus:border-brand">
            <option value="">Not archived</option>
            <option value="open">Open now</option>
            <option value="upcoming">Opening soon</option>
            <option value="closed">Closed</option>
            <option value="updates">Admit card, key or result out</option>
            <option value="all">Everything</option>
          </select>
        </div>
        <div>
          <label for="f-qual" class="mb-3 block text-xs font-bold uppercase tracking-wider text-[#94a3b8]">Qualification</label>
          <select id="f-qual" name="qual" class="w-full rounded-lg border border-line bg-paper p-2.5 text-sm outline-none focus:border-brand">
            <option value="">Any</option>
            {levels.map((l) => <option value={l}>{QUALIFICATION_LABEL[l]}</option>)}
          </select>
        </div>
        <div>
          <label for="f-jur" class="mb-3 block text-xs font-bold uppercase tracking-wider text-[#94a3b8]">Government</label>
          <select id="f-jur" name="jur" class="w-full rounded-lg border border-line bg-paper p-2.5 text-sm outline-none focus:border-brand">
            <option value="">Any</option>
            <option value="central">Central</option>
            <option value="state">State or UT</option>
          </select>
        </div>
        <div>
          <label for="f-state" class="mb-3 block text-xs font-bold uppercase tracking-wider text-[#94a3b8]">Location</label>
          <select id="f-state" name="state" class="w-full rounded-lg border border-line bg-paper p-2.5 text-sm outline-none focus:border-brand">
            <option value="">All India</option>
            {states.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div>
          <label for="f-sort" class="mb-3 block text-xs font-bold uppercase tracking-wider text-[#94a3b8]">Sort</label>
          <select id="f-sort" name="sort" class="w-full rounded-lg border border-line bg-paper p-2.5 text-sm outline-none focus:border-brand">
            <option value="deadline">Deadline, soonest first</option>
            <option value="newest">Newest notice first</option>
          </select>
        </div>
      </form>
    </aside>

    <section class="p-4 sm:p-8" aria-labelledby="results-h">
      <div class="mb-8 flex items-start justify-between gap-3">
        <div class="flex flex-col gap-1">
          <h1 id="results-h" class="font-display text-2xl font-bold text-ink">Active job openings</h1>
          <p id="count" class="text-sm text-ink-3" aria-live="polite">Showing {items.length} verified government openings.</p>
        </div>
        <button type="button" id="filter-open" class="btn shrink-0 lg:hidden" aria-controls="filter-panel" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8z"></path></svg>
          Filters
        </button>
      </div>
      <ul id="results" class="grid grid-cols-1 gap-6 xl:grid-cols-2">
        {
          items.map((it) => (
            <li
              data-item
              data-text={it.text}
              data-jur={it.o.organization.jurisdiction}
              data-states={it.states}
              data-quals={it.quals}
              data-end={it.end}
              data-notified={it.notified}
            >
              <OpportunityCard o={it.o} />
            </li>
          ))
        }
      </ul>
      <div id="empty" class="notice mt-4" hidden>
        <p class="font-medium text-ink">{items.length === 0 ? "The first verified notices are being added." : "No opportunities match these filters."}</p>
        <p class="mt-1">{items.length === 0 ? "Each notice appears here once a person has checked it against the official PDF." : "Try a shorter keyword, or set Status to “Everything” to include archived notices."}</p>
      </div>
    </section>
  </div>
</Base>

<script>
  // Phones: filters slide in from the left only when the Filters button is pressed.
  const panel = document.getElementById("filter-panel") as HTMLElement;
  const backdrop = document.getElementById("filter-backdrop") as HTMLElement;
  const openBtn = document.getElementById("filter-open") as HTMLButtonElement;
  const setOpen = (open: boolean) => {
    panel.classList.toggle("hidden", !open);
    backdrop.hidden = !open;
    openBtn.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };
  openBtn.addEventListener("click", () => setOpen(true));
  document.getElementById("filter-close")?.addEventListener("click", () => setOpen(false));
  backdrop.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => e.key === "Escape" && !backdrop.hidden && setOpen(false));
</script>

<script>
  import { computeStatus, type Status } from "@myavedan/schema/status";

  const form = document.getElementById("filters") as HTMLFormElement;
  const list = document.getElementById("results") as HTMLUListElement;
  const count = document.getElementById("count") as HTMLElement;
  const empty = document.getElementById("empty") as HTMLElement;
  const items = [...list.querySelectorAll<HTMLLIElement>("li[data-item]")];

  const statusOf = new Map<HTMLLIElement, Status>();
  for (const li of items) {
    const pill = li.querySelector<HTMLElement>("[data-live-status]");
    try {
      statusOf.set(li, computeStatus(JSON.parse(pill?.dataset.liveStatus ?? "")).status);
    } catch {
      statusOf.set(li, "upcoming");
    }
  }

  // Start from the URL so links like /explore/?qual=graduate work.
  const initial = new URLSearchParams(location.search);
  for (const [key, value] of initial) {
    const field = form.elements.namedItem(key);
    if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = value;
  }

  const UPDATES: Status[] = ["admit_card_out", "answer_key_out", "result_out"];
  function statusMatches(s: Status, want: string): boolean {
    switch (want) {
      case "":
        return s !== "archived";
      case "all":
        return true;
      case "updates":
        return UPDATES.includes(s);
      default:
        return s === want;
    }
  }

  const rank = (s: Status) => (s === "open" ? 0 : s === "upcoming" ? 1 : 2);
  function byDeadline(a: HTMLLIElement, b: HTMLLIElement): number {
    const ra = rank(statusOf.get(a)!);
    const rb = rank(statusOf.get(b)!);
    if (ra !== rb) return ra - rb;
    const ea = a.dataset.end ?? "";
    const eb = b.dataset.end ?? "";
    return ra < 2 ? ea.localeCompare(eb) : eb.localeCompare(ea);
  }
  const byNewest = (a: HTMLLIElement, b: HTMLLIElement) => (b.dataset.notified ?? "").localeCompare(a.dataset.notified ?? "");

  function apply() {
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? "").trim();
    const terms = get("q").toLowerCase().split(/\s+/).filter(Boolean);
    const qual = get("qual");
    const jur = get("jur");
    const state = get("state");
    const status = get("status");
    const sort = get("sort") || "deadline";

    let shown = 0;
    for (const li of items) {
      const ok =
        terms.every((t) => (li.dataset.text ?? "").includes(t)) &&
        (!qual || (li.dataset.quals ?? "").split("|").includes(qual)) &&
        (!jur || (jur === "state" ? li.dataset.jur !== "central" : li.dataset.jur === jur)) &&
        (!state || (li.dataset.states ?? "").split("|").includes(state)) &&
        statusMatches(statusOf.get(li)!, status);
      li.hidden = !ok;
      if (ok) shown++;
    }

    [...items].sort(sort === "newest" ? byNewest : byDeadline).forEach((li) => list.appendChild(li));

    count.textContent = `Showing ${shown} verified government ${shown === 1 ? "opening" : "openings"}.`;
    empty.hidden = shown > 0;

    const params = new URLSearchParams();
    for (const [k, v] of data) if (String(v) && !(k === "sort" && v === "deadline")) params.set(k, String(v));
    const qs = params.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  }

  form.addEventListener("input", apply);
  form.addEventListener("change", apply);
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    apply();
  });
  apply();
</script>
