---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="wrap py-16">
    <p class="eyebrow">404</p>
    <h1 class="mt-2 text-3xl sm:text-4xl">This page isn’t here</h1>
    <p class="mt-3 max-w-xl text-ink-2">The notice may have been archived, or the link may be mistyped.</p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a class="btn btn-primary" href="/explore/">Explore opportunities</a>
      <a class="btn" href="/">Go to the home page</a>
    </div>
  </section>
</Base>
