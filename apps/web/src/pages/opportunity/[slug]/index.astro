---
import Base from "../../../layouts/Base.astro";
import Timeline from "../../../components/Timeline.astro";
import SaveButton from "../../../components/SaveButton.astro";
import StatusPill from "../../../components/StatusPill.astro";
import EligibilityChecker from "../../../components/EligibilityChecker.tsx";
import {
  DATE_LABEL,
  EVENT_LABEL,
  QUALIFICATION_LABEL,
  dateValue,
  formatDate,
  formatDateTime,
  type Opportunity,
} from "@myavedan/schema";
import { inr, jurisdictionLabel, opportunities } from "../../../lib/snapshot";

export function getStaticPaths() {
  return opportunities.map((o) => ({ params: { slug: o.slug }, props: { o } }));
}

interface Props {
  o: Opportunity;
}
const { o } = Astro.props;
const pdf = o.links.notice_pdf;
const start = dateValue(o.dates, "apply_start");
const end = dateValue(o.dates, "apply_end");
const fees = o.fees.map((f) => f.amount_inr);
const feeMin = fees.length ? Math.min(...fees) : null;
const feeMax = fees.length ? Math.max(...fees) : null;
const feeRange =
  feeMin === null || feeMax === null
    ? "Not stated"
    : feeMin === feeMax
      ? inr(feeMax)
      : feeMin === 0
        ? `Up to ${inr(feeMax)}, some exempt`
        : `${inr(feeMin)} to ${inr(feeMax)}`;
const events = [...o.events].sort((a, b) => b.date.localeCompare(a.date));
const multiPost = o.posts.length > 1;

// Category columns in the usual order, then any others the notice uses (MBC, BC-A...); horizontal quotas last.
const ORDER = ["UR", "GEN", "GENERAL", "EWS", "OBC", "BC", "MBC", "SC", "ST"];
const rank = (g: string) => {
  const k = ORDER.indexOf(g.toUpperCase());
  return k === -1 ? ORDER.length : k;
};
const allSeats = o.posts.flatMap((p) => p.seats);
const seatGroups = {
  main: [...new Set(allSeats.filter((x) => !x.horizontal).map((x) => x.group))].sort((a, b) => rank(a) - rank(b)),
  within: [...new Set(allSeats.filter((x) => x.horizontal).map((x) => x.group))],
};

const RELAX_LABEL: Record<string, string> = { ESM: "Ex-servicemen", PwBD: "PwBD" };
const jump = [
  ["summary", "Summary"],
  ["dates", "Dates"],
  ["posts", "Posts"],
  ["eligibility", "Eligibility"],
  ["fees", "Fees"],
  ["selection", "Selection"],
  ["documents", "Documents"],
  ["timeline", "Timeline"],
  ["sources", "Sources"],
];
---

<Base title={o.title} description={o.summary.en}>
  <article data-pagefind-body>
    <div hidden data-pagefind-ignore>
      {o.qualification_levels.map((q) => <span data-pagefind-filter="Qualification">{QUALIFICATION_LABEL[q]}</span>)}
      {o.locations.map((l) => <span data-pagefind-filter="Location">{l}</span>)}
      <span data-pagefind-filter="Government">{o.organization.jurisdiction === "central" ? "Central" : "State or UT"}</span>
      <span data-pagefind-meta="organization">{o.organization.name}</span>
      {end && <span data-pagefind-sort="deadline">{end.slice(0, 10)}</span>}
    </div>

    <header class="hero-band border-b border-line">
      <div class="wrap py-8">
        <nav aria-label="Breadcrumb" class="text-sm text-ink-3">
          <a href="/explore/">Explore</a> <span aria-hidden="true">/</span>
          <span>{o.organization.short ?? o.organization.name}</span>
        </nav>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
          <StatusPill o={o} />
          {o.advt_no && <span class="text-sm text-ink-3">Advt. No. {o.advt_no}</span>}
          {o.sample && <span class="rounded bg-warn-soft px-1.5 py-0.5 text-xs font-semibold text-warn">Sample, not a real notice</span>}
        </div>
        <h1 class="mt-3 text-3xl sm:text-4xl" data-pagefind-meta="title">{o.title}</h1>
        <p class="mt-2 text-ink-2">
          {o.organization.name} · {jurisdictionLabel(o)} · official site <span class="text-sm">{o.organization.domain}</span>
        </p>

        <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="card">
            <dt class="text-xs text-ink-3">Apply online</dt>
            <dd class="num mt-0.5 font-semibold">
              {start ? formatDate(start) : "Not announced"} to {end ? formatDateTime(end) : "not announced"}
            </dd>
          </div>
          <div class="card">
            <dt class="text-xs text-ink-3">Vacancies</dt>
            <dd class="num mt-0.5 font-semibold">
              {o.total_vacancies !== null ? o.total_vacancies.toLocaleString("en-IN") : "Not stated"}
              {multiPost && <span class="font-normal text-ink-2"> across {o.posts.length} posts</span>}
            </dd>
          </div>
          <div class="card">
            <dt class="text-xs text-ink-3">Qualification</dt>
            <dd class="mt-0.5 font-semibold">{o.qualification_levels.map((q) => QUALIFICATION_LABEL[q]).join(" or ")}</dd>
          </div>
          <div class="card">
            <dt class="text-xs text-ink-3">Application fee</dt>
            <dd class="num mt-0.5 font-semibold">{feeRange}</dd>
          </div>
        </dl>

        <div class="mt-6 flex flex-wrap gap-2">
          <a class="btn btn-primary" href="#eligibility">Check my eligibility</a>
          <a class="btn" href={`/opportunity/${o.slug}/calendar.ics`} download={`${o.slug}.ics`}>Add dates to calendar</a>
          <SaveButton slug={o.slug} size="md" />
          <a class="btn" href={pdf} target="_blank" rel="noopener">Official notice (PDF) <span aria-hidden="true">↗</span></a>
          {
            o.links.apply && (
              <a class="btn" href={o.links.apply} target="_blank" rel="noopener">
                Apply on official site <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
      </div>
      <nav aria-label="On this page" class="border-t border-line">
        <ul class="wrap flex gap-1 overflow-x-auto py-2 text-sm">
          {jump.map(([id, label]) => <li><a class="block whitespace-nowrap rounded-md px-2.5 py-1 text-ink-2 no-underline hover:bg-sunk" href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    </header>

    <div class="wrap grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_19rem]">
      <div class="grid min-w-0 content-start gap-12">
        <section id="summary" aria-labelledby="summary-h">
          <h2 id="summary-h" class="section-title">Summary</h2>
          <p class="max-w-[68ch] text-[1.05rem] text-ink">{o.summary.en}</p>
          <p class="mt-2 text-xs text-ink-3">
            {o.summary.reviewed ? "Plain-language summary, checked by a reviewer against the notice." : "Summary not yet reviewed."} The
            official notice is the authority.
          </p>
        </section>

        <section id="dates" aria-labelledby="dates-h">
          <h2 id="dates-h" class="section-title">Important dates</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">Event</th><th scope="col">Date</th></tr></thead>
              <tbody>
                {
                  o.dates.map((d) => (
                    <tr>
                      <td>{d.label ?? DATE_LABEL[d.kind]}</td>
                      <td class="num">
                        {d.value ? formatDateTime(d.value) : (d.approx ?? "To be announced")}
                        {d.tentative && <span class="tentative ml-2">tentative</span>}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="mt-2 text-xs text-ink-3">All times are Indian Standard Time.</p>
        </section>

        <section id="posts" aria-labelledby="posts-h">
          <h2 id="posts-h" class="section-title">Posts and vacancies</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">Post</th><th scope="col">Vacancies</th><th scope="col">Pay</th></tr></thead>
              <tbody>
                {
                  o.posts.map((p) => (
                    <tr>
                      <td class="font-medium">{p.name}</td>
                      <td class="num">{p.vacancies !== null ? p.vacancies.toLocaleString("en-IN") : "Not stated"}</td>
                      <td>{p.pay ?? "Not stated"}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          {
            seatGroups.main.length > 0 && (
              <>
                <h3 class="mb-2 mt-6 font-display text-lg font-bold">Seats by category</h3>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Post</th>
                        {seatGroups.main.map((g) => <th scope="col" class="text-right">{g}</th>)}
                        <th scope="col" class="text-right">Total</th>
                        {seatGroups.within.map((g) => <th scope="col" class="text-right">{g}*</th>)}
                      </tr>
                    </thead>
                    <tbody>
                      {
                        o.posts
                          .filter((p) => p.seats.length > 0)
                          .map((p) => {
                            const count = (g: string) => p.seats.find((x) => x.group === g)?.count;
                            const total = p.seats.filter((x) => !x.horizontal).reduce((n, x) => n + x.count, 0);
                            return (
                              <tr>
                                <td class="font-medium">{p.name}</td>
                                {seatGroups.main.map((g) => <td class="num text-right">{count(g) ?? "–"}</td>)}
                                <td class="num text-right font-semibold">{total}</td>
                                {seatGroups.within.map((g) => <td class="num text-right text-ink-2">{count(g) ?? "–"}</td>)}
                              </tr>
                            );
                          })
                      }
                    </tbody>
                  </table>
                </div>
                {seatGroups.within.length > 0 && (
                  <p class="mt-2 text-xs text-ink-3">* {seatGroups.within.join(", ")} seats are counted within the category seats, not in addition to them.</p>
                )}
              </>
            )
          }
        </section>

        <section id="eligibility" aria-labelledby="elig-h">
          <h2 id="elig-h" class="section-title">Eligibility</h2>
          <p class="mb-4 max-w-[68ch] text-ink-2">The rules as the notice states them{multiPost ? ", post by post" : ""}. Check yourself against them below.</p>
          <div class="grid gap-4">
            {
              o.posts.map((p) => (
                <div class="card">
                  {multiPost && <h3 class="mb-2 text-lg">{p.name}</h3>}
                  <ul class="grid gap-2.5 text-[0.95rem]">
                    {p.rules.map((r) => (
                      <li>
                        {r.kind === "dob_window" && (
                          <>
                            <span class="font-semibold">Age: </span>
                            {r.stated}
                            {r.relaxations.length > 0 && (
                              <ul class="mt-1.5 ml-4 list-disc text-sm text-ink-2">
                                {r.relaxations.map((x) => (
                                  <li>
                                    {RELAX_LABEL[x.applies_to] ?? x.applies_to}:{" "}
                                    {x.years === null ? "relaxation as per Government rules (no figure given)" : `${x.years} years`}
                                    {x.cumulative ? ", on top of category relaxation" : ""}
                                  </li>
                                ))}
                              </ul>
                            )}
                          </>
                        )}
                        {r.kind === "qualification" && (
                          <>
                            <span class="font-semibold">Qualification: </span>
                            {r.stated}
                          </>
                        )}
                        {r.kind === "other" && (
                          <>
                            <span class="font-semibold">{r.label}: </span>
                            {r.stated}
                          </>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <div class="mt-6">
            <EligibilityChecker client:idle posts={o.posts.map(({ id, name, rules }) => ({ id, name, rules }))} pdf={pdf} />
          </div>
        </section>

        <section id="fees" aria-labelledby="fees-h">
          <h2 id="fees-h" class="section-title">Application fee</h2>
          {
            o.fees.length ? (
              <div class="table-wrap">
                <table>
                  <thead><tr><th scope="col">Who</th><th scope="col">Fee</th></tr></thead>
                  <tbody>
                    {o.fees.map((f) => (
                      <tr>
                        <td>{f.applies_to}</td>
                        <td class="num font-medium">{inr(f.amount_inr)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="notice">The notice does not state a fee.</p>
            )
          }
          <p class="mt-2 text-xs text-ink-3">Pay only on the official portal. MyAvedan never collects fees.</p>
        </section>

        <section id="selection" aria-labelledby="sel-h">
          <h2 id="sel-h" class="section-title">Selection process</h2>
          {
            o.selection_stages.length ? (
              <ol class="grid gap-2">
                {o.selection_stages.map((s, i) => (
                  <li class="flex items-start gap-3">
                    <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand-soft text-xs text-brand-ink">{i + 1}</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="notice">Not specified in the available notification.</p>
            )
          }
        </section>

        <section id="documents" aria-labelledby="docs-h">
          <h2 id="docs-h" class="section-title">Documents to keep ready</h2>
          {
            o.documents_required.length ? (
              <ul class="grid gap-1.5">
                {o.documents_required.map((d) => (
                  <li class="flex items-start gap-2">
                    <svg class="mt-1.5 shrink-0" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect x="1" y="1" width="10" height="10" rx="2" fill="none" stroke="var(--line-2)" stroke-width="1.5" /></svg>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="notice">Not specified in the available notification.</p>
            )
          }
          <p class="mt-2 text-xs text-ink-3">A checklist you can tick off is coming with saved opportunities.</p>
        </section>

        <section id="timeline" aria-labelledby="tl-h">
          <h2 id="tl-h" class="section-title">Timeline</h2>
          <p class="mb-4 text-sm text-ink-3">Every step of this recruitment in one place, from the notice to the result. Bookmark this page to follow it.</p>
          <Timeline o={o} />
        </section>
      </div>

      <aside id="sources" aria-labelledby="src-h" class="lg:sticky lg:top-4 lg:self-start">
        <div class="card text-sm">
          <h2 id="src-h" class="text-lg">Official source</h2>
          <dl class="mt-3 grid gap-2.5">
            <div><dt class="text-xs text-ink-3">Official site</dt><dd>{o.organization.domain}</dd></div>
            <div><dt class="text-xs text-ink-3">Checked by a person on</dt><dd class="num">{formatDateTime(o.provenance.reviewed_at)}</dd></div>
            {o.provenance.change_note && <div><dt class="text-xs text-ink-3">Latest change</dt><dd>{o.provenance.change_note}</dd></div>}
          </dl>
          <div class="mt-4 grid gap-2">
            <a class="btn justify-center" href={o.links.official_page} target="_blank" rel="noopener">Official recruitment page <span aria-hidden="true">↗</span></a>
          </div>
          <p class="mt-4 border-t border-line pt-3 text-ink-2">
            Spotted a mistake? <a href={`/about/?report=${o.slug}#corrections`}>Report an error</a>. We check reports against the notice.
          </p>
        </div>
        <p class="mt-3 px-1 text-xs text-ink-3">
          MyAvedan is not the recruiting authority. Always confirm details in the official notification before applying.
        </p>
      </aside>
    </div>
  </article>
</Base>
