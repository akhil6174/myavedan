{
  "name": "myavedan",
  "private": true,
  "description": "MyAvedan by TrutiAI: discover official recruitment notices, understand them, check eligibility, track what happens next.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run dev -w @myavedan/web",
    "build": "npm run build -w @myavedan/web",
    "preview": "npm run preview -w @myavedan/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p packages/schema && tsc -p packages/eligibility && tsc -p apps/api && tsc -p apps/admin && npm run check -w @myavedan/web",
    "validate:snapshot": "tsx packages/schema/scripts/validate-snapshot.ts data/snapshot.json",
    "build:admin": "npm run build -w @myavedan/admin",
    "dev:admin": "npm run dev -w @myavedan/admin",
    "dev:api": "npm run build:admin && npm run dev -w @myavedan/api",
    "db:migrate:local": "npm run db:migrate:local -w @myavedan/api",
    "db:seed:local": "npm run db:seed:local -w @myavedan/api",
    "seed:review": "node apps/api/scripts/seed-review.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
